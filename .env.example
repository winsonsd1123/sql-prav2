# 环境变量模板——复制为 .env.local 填入真实值（.env* 已被 gitignore）
# 带NEXT_PUBLIC_前缀的会进入浏览器包（本来就是公开设计）；其余仅服务端可见。

# ── Supabase（Dashboard → Settings → API）─────────────────
# 项目 URL，形如 https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon/publishable key（公开设计，配合 RLS 使用）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key：最高权限，仅服务端，绝不可带 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# ── 阿里云验证码 2.0 ──────────────────────────────────────
# 场景码：验证码控制台 → 场景管理（前端组件初始化需要，公开）
NEXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_CODE=
# 实例前缀：控制台概览 → 实例基本信息卡片（API 端点子域 {prefix}.captcha-open.aliyuncs.com，缺失会请求 undefined.* 导致组件不显示）
NEXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=
# AccessKey（建议 RAM 子账号、仅授予验证码核验权限），仅服务端
ALIYUN_CAPTCHA_ACCESS_KEY_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=
